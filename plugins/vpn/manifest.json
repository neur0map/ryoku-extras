{
  "id": "vpn",
  "name": "VPN",
  "version": "1.0.0",
  "author": "neur0map <hello@ryoku.dev>",
  "description": "Toggle your NetworkManager VPN from the top bar and watch its live connection state.",
  "license": "MIT",
  "official": false,
  "tags": ["vpn", "network", "bar-widget"],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml"
  },
  "files": [
    "assets/preview-widget.png"
  ],
  "capabilities": {
    "densities": ["glyph", "compact"]
  },
  "hosts": ["topbarGlyph"],
  "defaults": {
    "host": "topbarGlyph",
    "icon": "vpn_lock",
    "label": "VPN"
  },
  "dependencies": {
    "commands": ["nmcli"]
  },
  "metadata": {
    "settings": [
      { "key": "poll", "type": "int", "label": "Poll seconds", "group": "VPN", "default": 5, "min": 2, "max": 60 },
      { "key": "showName", "type": "toggle", "label": "Show connection name", "group": "VPN", "default": true },
      { "key": "types", "type": "text", "label": "Connection types", "group": "VPN", "default": "vpn,wireguard,tun" }
    ]
  }
}
